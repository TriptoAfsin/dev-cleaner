{
  "name": "dev-cleaner",
  "private": true,
  "license": "MIT",
  "version": "0.4.0",
  "type": "module",
  "description": "Reclaim disk and memory from developer caches, processes and ports. Rust core, React shell.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "app": "tauri dev",
    "app:build": "tauri build",
    "icon": "node scripts/make-icon.mjs && tauri icon app-icon.png",
    "version:patch": "node scripts/bump-version.mjs patch",
    "version:minor": "node scripts/bump-version.mjs minor",
    "version:major": "node scripts/bump-version.mjs major",
    "e2e:build": "node e2e/build.mjs",
    "e2e": "node e2e/fetch-driver.mjs && node --test --test-concurrency=1 --test-timeout=600000 \"e2e/tests/*.test.mjs\"",
    "screenshots": "node e2e/screenshots.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "@tauri-apps/plugin-opener": "^2.0.0",
    "html-to-image": "^1.11.13",
    "lucide-react": "^0.460.0",
    "marked": "^16.4.1",
    "motion": "^12.43.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "simple-icons": "^16.37.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.0.11"
  }
}
